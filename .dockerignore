# Allow only application build inputs. Never send local accounts, plans,
# credentials, QA recordings, or knowledge-base material to the builder.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!next.config.ts
!next-env.d.ts
!tsconfig.json
!app/
!app/**
!components/
!components/**
!lib/
!lib/**
!public/
!public/**
# Defense in depth, including files accidentally placed under allowed trees.
**/.env*
**/*.sqlplan
**/*.db
**/*.db-*
**/*.sqlite*
**/*.pem
**/*.key
**/node_modules/**
# The bundled sample the setup wizard offers ("Try a sample plan"): synthetic, safe to ship.
!public/samples/*.sqlplan
