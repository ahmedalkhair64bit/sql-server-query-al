# At least 16 characters. Encrypts the model keys you paste in /settings (AES-256-GCM).
# Changing it makes already-stored keys unreadable — you will have to paste them again.
APP_SECRET=replace-with-32-random-characters

# Where qai.db lives. Default ./data; the Docker image sets /data.
DATA_DIR=./data

# Only for a direct https deploy with no proxy setting X-Forwarded-Proto.
# Leave unset on plain http: Safari will not store a Secure cookie there.
# COOKIE_SECURE=1

# Set to 1 to let more people create accounts; only the first account can sign up otherwise.
# ALLOW_SIGNUP=1
