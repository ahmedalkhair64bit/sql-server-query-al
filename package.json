    "stress:api": "node --no-warnings scripts/stress-api.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@openuidev/lang-core": "^0.3.0",
    "@openuidev/react-lang": "^0.3.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "gsap": "^3.15.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "saxes": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "typescript": "^5"
  }
